{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "0.2.41",
  "identifier": "ai.pi.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 640,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MEM1MjBFNDUwREVDMTAKUldRUTdBMUZEbElNYWRINzZkMWNreEoyL2k5eGxXenpHTE1PTiswQnhTT0UxeWptOTdzMUZ5WFgK",
      "endpoints": [
        "https://github.com/ErKeLost/pi-gui/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "resources/gui-extension.ts",
      "resources/workspace.ts",
      "resources/subagents",
      "resources/computer-use",
      "resources/pi-computer-use",
      "resources/pi-runtime"
    ],
    "createUpdaterArtifacts": true
  }
}
