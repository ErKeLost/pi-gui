[Unit]
Description=Orbit Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbit-relay
Group=orbit-relay
WorkingDirectory=/opt/orbit-relay
EnvironmentFile=/etc/orbit-relay.env
Environment=PORT=8787
Environment=MAX_CLIENTS_PER_HOST=8
Environment=MAX_HOSTS_PER_IP=4
Environment=MAX_AUTH_FAILURES_PER_MINUTE=20
ExecStart=/usr/local/bin/bun /opt/orbit-relay/server.mjsRestart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orbit-relay

[Install]
WantedBy=multi-user.target
